# ============================================================
# Coffee Loyalty — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

APP_ENV=local
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# ---- Database ----
# For local development you can connect as the postgres superuser — RLS will
# be skipped (Postgres always bypasses RLS for superusers). For staging/prod
# use the dedicated app_role created by migration 0005:
#   DATABASE_URL=postgresql+asyncpg://app_role:<rotated_password>@host:5432/coffee_loyalty
# Rotate the default password after first deploy:
#   ALTER ROLE app_role PASSWORD '<strong secret>';
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/coffee_loyalty
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379/0

# ---- Telegram bots ----
# Get tokens from @BotFather. MVP uses two separate bots.
CUSTOMER_BOT_TOKEN=
STAFF_BOT_TOKEN=

# Webhook mode (production). Leave empty to use long-polling locally.
CUSTOMER_BOT_WEBHOOK_URL=
STAFF_BOT_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=change-me-32-bytes-random

# ---- Security ----
# Argon2 pepper — additional secret applied on top of salt for staff PIN/password
SECURITY_PEPPER=change-me-pepper-32-bytes-random
JWT_SECRET=change-me-jwt-secret-32-bytes-random
JWT_TTL_SECONDS=3600

# Set ADMIN_COOKIE_SECURE=false if you serve /admin over plain HTTP
# (e.g. via SSH tunnel on a server without TLS yet). Defaults to true in prod.
# ADMIN_COOKIE_SECURE=false

# ---- Defaults / behavior ----
DEFAULT_TIMEZONE=Asia/Tashkent
DEFAULT_LANGUAGE=ru
DEFAULT_CURRENCY=UZS

# Punchcard / loyalty defaults (overridable per-campaign in DB)
PUNCHCARD_DEFAULT_EXPIRES_DAYS=90
PUNCHCARD_DEFAULT_COOLDOWN_MIN=2
PREPAID_DEFAULT_EXPIRES_DAYS=180

# Notification rate-limits
TELEGRAM_GLOBAL_RPS=25
TELEGRAM_PER_CHAT_RPS=1

# Quiet hours (defaults; users can override)
QUIET_HOURS_FROM=22:00
QUIET_HOURS_TO=08:00
